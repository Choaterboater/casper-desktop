{
  "name": "@deepseek-ai/dsh-casper-desktop",
  "description": "Casper desktop: the desktop app's profile bundle, upstream's base and Web layers without the upstream service rows, followed by the Casper layer",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/casper/desktop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./casper.patch.yml": "./casper.patch.yml",
    "./generated/*.patch.yml": "./generated/*.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "generated/base.patch.yml",
    "generated/web-app.patch.yml",
    "generated/presets/standard.patch.yml",
    "generated/presets/ptc.patch.yml",
    "generated/presets/minimal.patch.yml",
    "generated/presets/cordis.patch.yml",
    "generated/presets/casper.patch.yml",
    "casper.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./generated/base.patch.yml",
        "./generated/web-app.patch.yml",
        "./generated/presets/standard.patch.yml",
        "./generated/presets/ptc.patch.yml",
        "./generated/presets/minimal.patch.yml",
        "./generated/presets/cordis.patch.yml",
        "./generated/presets/casper.patch.yml",
        "./casper.patch.yml"
      ],
      "listedByDefault": false
    }
  },
